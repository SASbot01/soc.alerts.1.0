# Suricata Threshold Configuration
# ================================
# Use this file to suppress noisy rules or set rate limits.
#
# Examples:
#   suppress gen_id 1, sig_id 2100498
#   threshold gen_id 1, sig_id 2100498, type limit, track by_src, count 1, seconds 60
#   rate_filter gen_id 1, sig_id 2100366, track by_src, count 5, seconds 60, new_action drop, timeout 300

# --- Suppress noisy rules (legitimate traffic) ---
# STUN/Tailscale NAT traversal heartbeats
suppress gen_id 1, sig_id 2016149
suppress gen_id 1, sig_id 2016150
# SSDP UPnP discovery (local network)
suppress gen_id 1, sig_id 2019102

# --- Cloudflare Tunnel IPs (legitimate proxy traffic, not real scans) ---
# https://www.cloudflare.com/ips/
suppress gen_id 1, sig_id 9000001, track by_src, ip 198.41.192.0/24
suppress gen_id 1, sig_id 9000006, track by_src, ip 198.41.192.0/24
suppress gen_id 1, sig_id 9000007, track by_src, ip 198.41.192.0/24
suppress gen_id 1, sig_id 9000012, track by_src, ip 198.41.192.0/24

# --- Whitelist 79.117.241.86 (legitimate traffic, 259 PORT_SCAN false positives) ---
suppress gen_id 1, sig_id 9000001, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000002, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000003, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000004, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000005, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000006, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000007, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000012, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000020, track by_src, ip 79.117.241.86
suppress gen_id 1, sig_id 9000030, track by_src, ip 79.117.241.86

# --- DNS rule tuning (SID:2047122 - noisy DNS queries / Cloudflare tunneling) ---
# Rate-limit to 1 alert per source IP per 5 minutes instead of every query
threshold gen_id 1, sig_id 2047122, type limit, track by_src, count 1, seconds 300

# --- Suppress common DNS false positives (normal resolver traffic) ---
# Cloudflare DNS (1.1.1.1, 1.0.0.1)
suppress gen_id 1, sig_id 2047122, track by_dst, ip 1.1.1.1
suppress gen_id 1, sig_id 2047122, track by_dst, ip 1.0.0.1
# Google DNS
suppress gen_id 1, sig_id 2047122, track by_dst, ip 8.8.8.8
suppress gen_id 1, sig_id 2047122, track by_dst, ip 8.8.4.4
