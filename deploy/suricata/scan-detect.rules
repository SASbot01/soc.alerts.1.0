# ================================================================
# BlackWolf SOC - Custom Scan Detection Rules
# ================================================================

# --- SYN Scan (nmap -sS, masscan) ---
# High rate SYN packets from single source = port scan
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nmap SYN Scan Detected"; flags:S,12; threshold: type both, track by_src, count 25, seconds 10; classtype:attempted-recon; sid:9000001; rev:2;)

# --- NULL Scan (nmap -sN) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN TCP NULL Scan"; flags:0; classtype:attempted-recon; sid:9000002; rev:1;)

# --- XMAS Scan (nmap -sX) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN TCP XMAS Scan"; flags:FPU; classtype:attempted-recon; sid:9000003; rev:1;)

# --- FIN Scan (nmap -sF) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN TCP FIN Scan"; flags:F,12; classtype:attempted-recon; sid:9000004; rev:1;)

# --- Nmap OS Detection (unusual flag combinations) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nmap OS Fingerprint (SFPAU)"; flags:SFPAU; classtype:attempted-recon; sid:9000005; rev:1;)

# --- Masscan signature (window size 1024, SYN only) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Masscan SYN (window 1024)"; flags:S; window:1024; threshold: type both, track by_src, count 50, seconds 10; classtype:attempted-recon; sid:9000006; rev:1;)

# --- UDP Scan ---
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN UDP Port Scan Detected"; threshold: type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:9000007; rev:1;)

# --- Nmap service version detection probes ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nmap Service Version Probe"; flow:established,to_server; content:"Nmap"; nocase; classtype:attempted-recon; sid:9000010; rev:1;)

# --- Nmap scripting engine (NSE) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nmap NSE Script Activity"; flow:established,to_server; content:"nmap"; nocase; content:"script"; nocase; distance:0; within:50; classtype:attempted-recon; sid:9000011; rev:1;)

# --- ZMap signature (SYN with specific IP ID) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN ZMap Scanner Detected"; flags:S; window:65535; threshold: type both, track by_src, count 100, seconds 10; classtype:attempted-recon; sid:9000012; rev:1;)

# --- ICMP Sweep (ping scan) ---
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN ICMP Ping Sweep"; itype:8; threshold: type both, track by_src, count 10, seconds 10; classtype:attempted-recon; sid:9000020; rev:1;)

# --- SSH brute force (rapid connections) ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SCAN SSH Brute Force Attempt"; flags:S; threshold: type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000030; rev:1;)

# --- HTTP scanner user-agents ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nmap HTTP Scanner UA"; flow:established,to_server; http.user_agent; content:"Nmap"; nocase; classtype:attempted-recon; sid:9000040; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nikto Scanner UA"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; classtype:attempted-recon; sid:9000041; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Nuclei Scanner UA"; flow:established,to_server; http.user_agent; content:"nuclei"; nocase; classtype:attempted-recon; sid:9000042; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Gobuster Scanner UA"; flow:established,to_server; http.user_agent; content:"gobuster"; nocase; classtype:attempted-recon; sid:9000043; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN SQLmap Scanner UA"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000044; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Masscan HTTP Scanner UA"; flow:established,to_server; http.user_agent; content:"masscan"; nocase; classtype:attempted-recon; sid:9000045; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN WPScan Scanner UA"; flow:established,to_server; http.user_agent; content:"WPScan"; nocase; classtype:attempted-recon; sid:9000046; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Dirbuster Scanner UA"; flow:established,to_server; http.user_agent; content:"DirBuster"; nocase; classtype:attempted-recon; sid:9000047; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SCAN Feroxbuster Scanner UA"; flow:established,to_server; http.user_agent; content:"feroxbuster"; nocase; classtype:attempted-recon; sid:9000048; rev:1;)
