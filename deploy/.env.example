# Copy this file to .env and fill in the values
# cp .env.example .env

# ===== REQUIRED =====

# JWT Secret (min 64 chars, MUST change in production)
JWT_SECRET=YOUR_SECURE_64_CHAR_MINIMUM_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION_NOW
# Access token expiry in ms (default: 15 min)
JWT_EXPIRATION_MS=900000
# Refresh token expiry in days (default: 7)
JWT_REFRESH_EXPIRATION_DAYS=7
# Set to true when using HTTPS (required for soc.blackwolfsec.io)
JWT_COOKIE_SECURE=true

# ===== DATABASE =====
MYSQL_HOST=mysql
MYSQL_DATABASE=blackwolf
MYSQL_USER=root
MYSQL_PASSWORD=admin

# ===== INTEGRATIONS =====

# Slack Global Alerts
GLOBAL_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
GLOBAL_SLACK_ENABLED=true

# AI Chat (Claude)
CLAUDE_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_ENABLED=true

# AI Threat Analyst Agent (Scheduled Reports)
AI_AGENT_ENABLED=false
AI_AGENT_MAX_TOKENS=8192
# Create a Slack Incoming Webhook for your channel (e.g. C0AG5TFNSDB)
# https://api.slack.com/messaging/webhooks
AI_AGENT_SLACK_WEBHOOK=
AI_AGENT_SLACK_ENABLED=false
AI_AGENT_CRON=0 0 */6 * * *
AI_AGENT_ANALYSIS_HOURS=24

# AI Autonomous Agent (Real-time Threat Analysis & Response)
AI_AUTONOMOUS_ENABLED=false
AI_AUTONOMOUS_MAX_TOKENS=4096
# Batch interval in ms (default: 120000 = 2 minutes)
AI_AUTONOMOUS_BATCH_INTERVAL_MS=120000
# Threats with severity >= this get immediate analysis (default: 8)
AI_AUTONOMOUS_CRITICAL_THRESHOLD=8
# Auto-block malicious IPs (default: true)
AI_AUTONOMOUS_AUTO_BLOCK=true
# Auto-create incidents for real attacks (default: true)
AI_AUTONOMOUS_AUTO_INCIDENT=true
# Learn noise patterns to suppress repeated false positives (default: true)
AI_AUTONOMOUS_NOISE_LEARNING=true

# Threat Intelligence
ABUSEIPDB_API_KEY=your-abuseipdb-key
ABUSEIPDB_ENABLED=false

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://soc.blackwolfsec.io,http://soc.blackwolfsec.io

# ===== SURICATA IDS =====
SURICATA_INTERFACE=enp1s0
SURICATA_HOME_NET=[192.168.1.0/24]
SOC_API_KEY=your-company-api-key
SOC_COMPANY_ID=your-company-uuid
SOC_SENSOR_ID=sensor-suricata-ids
BRIDGE_BATCH_INTERVAL=10

# ===== OPTIONAL =====

# Email Alerts
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email
# MAIL_PASSWORD=your-password

# Cloudflare Tunnel
# TUNNEL_TOKEN=your-tunnel-token
