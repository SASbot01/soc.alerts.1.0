# ── Mythonos Engine ──

# Anthropic API key — required to run the agent
ANTHROPIC_API_KEY=sk-ant-...

# Active model. When Mythos is publicly released, change this to "mythos-preview"
# (or whatever model id Anthropic publishes) — no other code changes required.
MYTHONOS_MODEL=claude-opus-4-6

# Optional: prompt-cache for prefix reuse on repeated tool loops
MYTHONOS_PROMPT_CACHE=true

# Max iterations the agent loop can take per scan before stopping
MYTHONOS_MAX_ITERATIONS=40

# Where scan target sources / binaries live (mounted into the container).
# Each scan creates its own subdir for sandboxed work.
MYTHONOS_TARGETS_DIR=/app/targets
MYTHONOS_DATA_DIR=/app/data

# Sandbox mode:
#   inline  → run tool commands directly inside this container (simplest)
#   docker  → spawn a one-shot disposable container per command (safer)
MYTHONOS_SANDBOX=inline

# HTTP server
PORT=3900
HOST=0.0.0.0

# Auth — shared bearer token between SOC backend/proxy and engine
MYTHONOS_AUTH_TOKEN=change-me-mythonos-token
